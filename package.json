{
  "name": "motiongx",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "pnpm remotion:bundle && pnpm preview:build && next build",
    "start": "next start",
    "lint": "eslint && node scripts/check-logical.mjs",
    "i18n:check": "node scripts/i18n-check.mjs",
    "remotion:bundle": "tsx --tsconfig tsconfig.scripts.json scripts/motion/bundle.ts",
    "remotion:studio": "remotion studio remotion/index.ts",
    "music:generate": ".venv/bin/python scripts/music/generate.py --library --length 70",
    "music:upload": "tsx --env-file=.env.local --tsconfig tsconfig.scripts.json scripts/music/upload.ts",
    "preview:build": "tsx --tsconfig tsconfig.scripts.json scripts/motion/build-preview.ts",
    "refs:import": "tsx --env-file=.env.local --tsconfig tsconfig.scripts.json scripts/motion/refs-import.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.133.0",
    "@huggingface/transformers": "4.3.1",
    "@react-three/fiber": "9.3.0",
    "@remotion/bundler": "4.0.534",
    "@remotion/cli": "4.0.534",
    "@remotion/google-fonts": "4.0.534",
    "@remotion/layout-utils": "4.0.534",
    "@remotion/lottie": "4.0.534",
    "@remotion/media-utils": "4.0.534",
    "@remotion/motion-blur": "4.0.534",
    "@remotion/noise": "4.0.534",
    "@remotion/paths": "4.0.534",
    "@remotion/player": "4.0.534",
    "@remotion/renderer": "4.0.534",
    "@remotion/shapes": "4.0.534",
    "@remotion/three": "4.0.534",
    "@remotion/transitions": "4.0.534",
    "@remotion/vercel": "4.0.534",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "^2.117.3",
    "@vercel/sandbox": "^3.6.1",
    "esbuild": "0.28.1",
    "fontkit": "2.0.4",
    "lottie-web": "5.13.0",
    "next": "16.4.0",
    "next-intl": "4.14.9",
    "pngjs": "7.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "remotion": "4.0.534",
    "server-only": "^0.0.1",
    "three": "0.180.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/fontkit": "2.0.8",
    "@types/node": "^20",
    "@types/pngjs": "6.0.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "0.180.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "tailwindcss": "^4",
    "tsx": "4.20.3",
    "typescript": "^5"
  },
  "packageManager": "pnpm@12.11.2"
}
