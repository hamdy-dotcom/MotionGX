# ── Required ──────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
ANTHROPIC_API_KEY=
# posts: GPT Image
OPENAI_API_KEY=
# engine for new videos: director | live | legacy (dev configs in .claude/launch.json set it)
VIDEO_ENGINE=director
# where job workers run: local | sandbox
LIVE_ENGINE_RUNNER=local

# ── Brand capture ─────────────────────────────────────────
# test phone / email the capture agent uses to sign up to apps
TEST_PHONE=
TEST_EMAIL=
# legacy homepage extractor only (VIDEO_ENGINE=legacy)
FIRECRAWL_API_KEY=

# ── Jobs ──────────────────────────────────────────────────
# watchdog auth (Vercel cron sends CRON_SECRET)
CRON_SECRET=
LIVE_WATCHDOG_TOKEN=
# public URL workers report progress to (defaults to the request origin / VERCEL_URL)
LIVE_ENGINE_CALLBACK_URL=

# ── Optional tuning ───────────────────────────────────────
# DIRECTOR_MODEL=claude-opus-5-5
# DIRECTOR_MAX_USD=
# POSTS_MODEL=
# POSTS_IMAGE_MODEL=
# POSTS_IMAGE_QUALITY=
# POSTS_MAX_USD=
# FFMPEG_PATH=
